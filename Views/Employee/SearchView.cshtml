@model List<Employee>

<h1>Employee Management</h1>
<hr />
<div class="mb-3">
    <label for="nameFilter">Name:</label>
    <input type="text" id="nameFilter" name="nameFilter" class="form-control d-inline-block w-auto" placeholder="" />
    <div class="mt-3">
        <label for="departmentFilter">Department:</label>
        <select id="departmentFilter" name="department" asp-items="ViewBag.Departments" class="form-select d-inline-block w-auto">
            <option value="">-- All Departments --</option>
        </select>
    </div>
    <div class="mt-3">
        <button type="button" id="searchButton" class="btn btn-primary d-inline-block w-auto">Search</button>
        <button type="button" class="btn btn-primary d-inline-block w-auto clear-btn">Clear</button>
    </div>  
</div>
<hr />
<div class="mt-3">
    <table id="grid1" class="table table-striped table-bordered nowrap" style="border-collapse:collapse;border-spacing:0;width:100%;"></table>
    <div id="pager"></div>
</div>

@section Scripts {
    <!-- 1. Full, valid CDN URLs for Free jqGrid -->
    <!-- Core JS (includes English locale by default) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/free-jqgrid/4.15.5/jquery.jqgrid.min.js"></script>

    <script>
        $(document).ready(function () {
            // 2. Initialize the grid ONCE when the page loads
            $("#grid1").jqGrid({
                url: '@Url.Action("Search", "Employee")',
                datatype: "json",
                mtype: "GET",
                colModel: [
                    { name: "employeeId", label: "ID", key: true, width: 60 },
                    { name: "firstName", label: "First Name", width: 150 },
                    { name: "lastName", label: "Last Name", width: 150 },
                    { name: "email", label: "Email", width: 200 },
                    { name: "department", label: "Department", width: 150 }
                ],
                jsonReader: {
                    repeatitems: false,
                    id: "employeeId"        // Explicitly maps the row ID
                },
                pager: "#pager",
                rowNum: 20,
                viewrecords: true,
                height: "auto"
            });

            // 3. On search button click, update the URL with the search term and reload
            $("#searchButton").click(function (evt) {
                evt.preventDefault();

                // Qstn 27: Use jQuery .val() to read the term
                var term = $("#nameFilter").val();
                var department = $("#departmentFilter").val();

                // Qstn 28: console.log the term on click
                console.log(term);

                var url = '@Url.Action("Search", "Employee")' + "?term=" + encodeURIComponent(term) + "&department=" + encodeURIComponent(department);

                $("#grid1")
                    .jqGrid("setGridParam", {
                        url: url,
                        datatype: "json"
                    })
                    .trigger("reloadGrid", [{ page: 1 }]);
            });

            //Clear button click event handler
            $(document).on("click", ".clear-btn", function (evt) {
                evt.preventDefault();

                $("#nameFilter").val("");
                $("#departmentFilter").val("");

            });

        });
    </script>
}